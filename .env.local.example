# Kedar ERP API (must run on port 3001 — do not use 3001 for Foundation)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Local dev: Foundation runs on port 3002 (see package.json "dev" script).
# When deployed, add your production Foundation URL to backend FRONTEND_URL for CORS:
# FRONTEND_URL=http://localhost:3000,https://your-foundation-site.vercel.app
